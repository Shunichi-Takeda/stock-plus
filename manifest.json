{
  "manifest_version": 3,
  "name": "Stock Plus",
  "version": "0.8.0",
  "description": "Stock（stock-app.jp）を拡張するツールキット。返信済みトラッキング、チャット画面のピン留め等。",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["https://www.stock-app.jp/*", "https://*.stock-app.jp/*"],
      "js": [
        "src/core/util.js",
        "src/core/storage.js",
        "src/core/featureManager.js",
        "src/features/repliedMessages.js",
        "src/features/chatroomPin.js",
        "src/content.js"
      ],
      "css": ["src/styles/stock-plus.css"],
      "run_at": "document_idle"
    }
  ]
}
